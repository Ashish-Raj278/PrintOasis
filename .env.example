# PostgreSQL is required. Use a dedicated database URL; do not use a production database for TEST_DATABASE_URL.
DATABASE_URL=postgresql://printoasis:change-this@localhost:5432/printoasis
# Use SSL for managed PostgreSQL. Set PGSSL_REJECT_UNAUTHORIZED=false only when your provider requires it.
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
# Shared sessions/rate limits. rediss:// is supported for managed TLS Redis.
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=printoasis
REDIS_CONNECT_TIMEOUT_MS=5000
# Trust only this many reverse-proxy hops. Keep 0 unless the app is behind a known proxy chain.
TRUST_PROXY_HOPS=0
# Copy the Session Pooler URI for a separate Supabase test project; replace every placeholder.
# The username must be postgres.<20-character-project-ref>; the isolation guard requires
# that project reference to differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres.<TEST_PROJECT_REF>:<URL_ENCODED_PASSWORD>@<POOLER_HOST>:<PORT>/postgres
# Must be a separate Redis endpoint from REDIS_URL; used only by smoke/regression tests.
TEST_REDIS_URL=redis://localhost:6380/0
TEST_REDIS_PREFIX=printoasis:test

# Canonical origin used for links and cookie security; production must use HTTPS.
BASE_URL=http://localhost:3000
PORT=3000
# DATA_DIR stores local email-outbox operational copies and staging; it is not a database location.
DATA_DIR=

# Local uploads use DATA_DIR when not running in production.
OBJECT_STORAGE_BACKEND=local
# Production requires an S3-compatible endpoint and separate buckets.
# Set these as private deployment variables; do not store real credentials here.
# OBJECT_STORAGE_BACKEND=s3
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_PUBLIC_BUCKET=
# OBJECT_STORAGE_PRIVATE_BUCKET=
# OBJECT_STORAGE_FORCE_PATH_STYLE=false
# OBJECT_STORAGE_TIMEOUT_MS=30000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-production

EMAIL_DELIVERY_ENABLED=true
EMAIL_FROM=PrintOasis <orders@example.com>
# SMTP is not checked by /healthz. Failed sends are recorded/logged but are not automatically retried.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_WEBHOOK_URL=

SUPPORT_EMAIL=hello@printoasis.in
SUPPORT_PHONE=+91 80 4567 8900
OFFICE_ADDRESS=Bengaluru, Karnataka, India
CONTACT_RECIPIENT=admin@example.com

# Invoice defaults preserve the current tax-inclusive 18% display calculation.
# A tax professional must confirm the rate and shipping/product treatment before launch.
GST_RATE_BPS=1800
# Supply real seller values through private deployment configuration; no examples are inferred.
SELLER_LEGAL_NAME=
SELLER_REGISTERED_ADDRESS=
SELLER_GSTIN=

GOOGLE_CLIENT_ID=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
