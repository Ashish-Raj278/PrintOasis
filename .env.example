# Optional public URL of the deployed website. Do not include a trailing slash.
# Set this when using a custom domain.
BASE_URL=https://your-domain.example

# Optional database directory. Hosting uses this for persistent storage.
DATA_DIR=

# Admin account for /admin. Required in production.
ADMIN_EMAIL=admin@printoasis.example
ADMIN_PASSWORD=change-this-strong-password

# Email notifications via Nodemailer SMTP.
EMAIL_FROM=orders@your-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional fallback if you use an email webhook instead of SMTP.
EMAIL_WEBHOOK_URL=

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=

# Razorpay Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Hosting providers usually supply PORT automatically.
PORT=3000
