# PostgreSQL is required. Use a dedicated database URL; do not use a production database for TEST_DATABASE_URL.
DATABASE_URL=postgresql://printoasis:change-this@localhost:5432/printoasis
# Use SSL for managed PostgreSQL. Set PGSSL_REJECT_UNAUTHORIZED=false only when your provider requires it.
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
# Isolated database used only by npm run db:smoke. It must not be a production database.
TEST_DATABASE_URL=postgresql://printoasis_test:change-this@localhost:5432/printoasis_test

BASE_URL=http://localhost:3000
PORT=3000
# DATA_DIR stores uploads and the email outbox only; it is not a database location.
DATA_DIR=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-production

EMAIL_DELIVERY_ENABLED=true
EMAIL_FROM=PrintOasis <orders@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_WEBHOOK_URL=

SUPPORT_EMAIL=hello@printoasis.in
SUPPORT_PHONE=+91 80 4567 8900
OFFICE_ADDRESS=Bengaluru, Karnataka, India
CONTACT_RECIPIENT=admin@example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=